{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "JWT": {
    "Issuer": "https://localhost:7157",
    "Audience": "https://localhost:7157",
    "SigningKey": "test_signing_key_for_integration_tests_only_do_not_use_in_prod_1234567890",
    "ExpirationMinutes": 15
  },
  "Seed": {
    "AdminEmail": "admin@test.com",
    "AdminPassword": "Test_Admin_Password123"
  },
  "Cache": {
    "BanUserTtl": "00:05:00"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 1000000,
      "WindowSeconds": 1
    },
    "Auth": {
      "PermitLimit": 1000000,
      "WindowSeconds": 1
    }
  }
}
